{
  "name": "lightcues",
  "productName": "LightCues",
  "version": "0.1.2",
  "private": true,
  "description": "Windows lighting controller for live music shows",
  "license": "GPL-3.0-only",
  "author": "Georgios Koulouris",
  "homepage": "https://github.com/GiorgosKoulouris/LightCues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GiorgosKoulouris/LightCues.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.engine.json && tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "security:scan": "node scripts/security-scan.mjs",
    "security:test-rules": "semgrep --test --metrics=off security/semgrep",
    "icon": "node scripts/make-icon.mjs",
    "examples": "node scripts/make-examples.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/asar": "^4.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.63.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "serialport": "^13.0.0"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "@julusian/midi@3.8.1": true,
    "electron-winstaller@5.4.0": true
  }
}
